{
  "name": "@botbond/payment-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BotBond role C — Solana bond adapter + capped-session payment adapter (docs/09 contracts)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settlement-evidence": {
      "types": "./dist/settlement-evidence.d.ts",
      "default": "./dist/settlement-evidence.js"
    },
    "./idl/botbond.json": "./idl/botbond.json"
  },
  "files": ["dist", "idl"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@botbond/contracts": "*",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.0"
  }
}
