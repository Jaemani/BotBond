{
  "name": "@botbond/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "process-expirations": "node dist/scripts/process-expirations.js",
    "process-expirations:dev": "tsx scripts/process-expirations.ts",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@botbond/contracts": "*",
    "@botbond/observability": "*",
    "@fastify/swagger": "^9.5.1",
    "@google-cloud/firestore": "^8.7.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
